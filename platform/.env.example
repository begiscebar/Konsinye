# Postgres connection used by Prisma
DATABASE_URL="postgresql://konsinye:konsinye@localhost:5432/konsinye_freight"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Future integrations (not required to run the MVP) ---
# Maps/routing provider (Google Maps or Mapbox). Leave unset to use the
# built-in ManualLocationProvider (estimated distance/time only).
# MAPS_PROVIDER_API_KEY=

# GPS/ELD provider (e.g. Samsara, Motive). Leave unset to use manual
# location entry.
# ELD_PROVIDER_API_KEY=

# Stripe (payments). Leave unset to use the ManualPaymentProvider.
# STRIPE_SECRET_KEY=

# SMS/Email (Twilio / SES / Postmark). Leave unset — notifications stay
# in-app only and are logged to the console instead of sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# EMAIL_PROVIDER_API_KEY=
